# ============================================
# Video Editor — Configuration développement UNIQUEMENT
# ============================================
# Ce fichier est un exemple. Copiez-le en .env pour votre environnement
# local ; ne jamais committer .env (voir .gitignore).
#
# En production (build Nuitka/PyInstaller), ces valeurs sont ignorées.
# Les préférences utilisateur passent par AppSettings (core/settings.py),
# persistées en JSON dans le dossier de configuration standard de l'OS.

# Chemin explicite vers FFmpeg, si non présent dans le PATH système
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Clé API pour une éventuelle version cloud de Whisper (itération 13+)
# WHISPER_API_KEY=

# Active le niveau DEBUG en console (cf. core/logger.py configure_logging)
# VIDEO_EDITOR_DEBUG=1
